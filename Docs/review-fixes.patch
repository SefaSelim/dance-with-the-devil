From ced4cff39dbdcd94bf23e7a19f3295de6af1bc0c Mon Sep 17 00:00:00 2001
From: SefaSelim <sefaselimtura@gmail.com>
Date: Sat, 24 Oct 2026 10:54:18 +0300
Subject: [PATCH 1/2] Fire rifle and rocket from the muzzle toward the cursor
 aim point

Shots left the muzzle (0.37 m beside the body) along the body-to-cursor
direction, so they flew parallel to the cursor line and could miss an
enemy under the cursor at close range.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Assets/_Game/Scripts/Weapons/WeaponHub.cs | 26 +++++++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/Assets/_Game/Scripts/Weapons/WeaponHub.cs b/Assets/_Game/Scripts/Weapons/WeaponHub.cs
index 550900c..55bf4ee 100644
--- a/Assets/_Game/Scripts/Weapons/WeaponHub.cs
+++ b/Assets/_Game/Scripts/Weapons/WeaponHub.cs
@@ -35,6 +35,8 @@ private void Awake()
             if (_machete == null) _machete = GetComponentInChildren<Machete>();
         }
 
+        private const float MinMuzzleAimDistance = 1f;
+
         private void Update()
         {
             if (_input == null || _player == null || _player.Health.IsDead) return;
@@ -45,11 +47,31 @@ private void Update()
             if (_machete != null && _input.MeleePressed) _machete.TrySwing(aim);
 
             if (_rocketLauncher != null && _input.RocketPressed)
-                _rocketLauncher.TryFire(_rocketLauncher.MuzzlePosition, aim);
+            {
+                Vector3 muzzle = _rocketLauncher.MuzzlePosition;
+                _rocketLauncher.TryFire(muzzle, AimFrom(muzzle, aim));
+            }
 
             bool swinging = _machete != null && _machete.IsSwinging;
             if (_rifle != null && !swinging && _input.FireHeld)
-                _rifle.TryFire(_rifle.MuzzlePosition, aim);
+            {
+                Vector3 muzzle = _rifle.MuzzlePosition;
+                _rifle.TryFire(muzzle, AimFrom(muzzle, aim));
+            }
+        }
+
+        /// <summary>
+        /// Flat direction from the muzzle to the cursor's aim point, so shots go where the cursor is although the
+        /// muzzle sits beside the body. Falls back to the body aim when the cursor is closer than
+        /// <see cref="MinMuzzleAimDistance"/> to the muzzle or behind it (the line would swing wildly).
+        /// </summary>
+        private Vector3 AimFrom(Vector3 muzzle, Vector3 bodyAim)
+        {
+            Vector3 toAim = _player.AimPoint - muzzle;
+            toAim.y = 0f;
+            if (toAim.sqrMagnitude < MinMuzzleAimDistance * MinMuzzleAimDistance) return bodyAim;
+            toAim.Normalize();
+            return Vector3.Dot(toAim, bodyAim) > 0f ? toAim : bodyAim;
         }
     }
 }
-- 
