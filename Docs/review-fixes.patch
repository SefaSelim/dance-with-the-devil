             _cardHasChoice = offersChoice;
+            _eArmed = false;
+            _eUpTime = 0f;
             _mode = Mode.Card;
             _promptTime = 0f;
         }
@@ -120,13 +127,20 @@ private void Update()
                 ApplyEnter(EnterDuration > 0f ? _enterTime / EnterDuration : 1f);
             }
 
+            if (_mode == Mode.Card && Keyboard.current != null)
+            {
+                // Arms only after E has stayed up for a moment: repeated rocket taps keep it disarmed.
+                _eUpTime = Keyboard.current.eKey.isPressed ? 0f : _eUpTime + dt;
+                if (_eUpTime >= EArmDelay) _eArmed = true;
+            }
+
             if (_promptTime < _inputLock) return;
 
             if (_mode == Mode.Card && _cardHasChoice)
             {
                 Keyboard k = Keyboard.current;
                 Gamepad g = Gamepad.current;
-                if (UiKit.ConfirmPressed() || (k != null && k.eKey.wasPressedThisFrame)) RaiseYes();
+                if (UiKit.ConfirmPressed() || (_eArmed && k != null && k.eKey.wasPressedThisFrame)) RaiseYes();
                 else if ((k != null && k.hKey.wasPressedThisFrame) || (g != null && g.buttonEast.wasPressedThisFrame)) RaiseNo();
                 return;
