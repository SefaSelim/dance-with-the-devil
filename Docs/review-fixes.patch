From 817b79640b93da5409a1a63af4a42c8c1e1a98c0 Mon Sep 17 00:00:00 2001
From: SefaSelim <sefaselimtura@gmail.com>
Date: Sat, 24 Oct 2026 10:56:33 +0300
Subject: [PATCH 2/2] Review fixes: wall-shielded rockets, safe contract YES
 key, stable spawn queue

- RocketLauncher: walls block explosion damage (raycast to each target).
- DevilScreen: E only accepts after it stayed up 0.4 s on the card, so
  rocket taps from combat cannot sign a contract.
- WaveDirector: snap jittered spawns onto the NavMesh; stable insertion
  sort keeps the interleaved sub-group order (List.Sort is unstable).
- PixelCameraRig: XML doc back on ScreenPointToWorldRay.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Assets/_Game/Scripts/Core/PixelCameraRig.cs   |  8 +++---
 Assets/_Game/Scripts/Core/WaveDirector.cs     | 19 ++++++++++++--
 Assets/_Game/Scripts/UI/DevilScreen.cs        | 16 +++++++++++-
 .../_Game/Scripts/Weapons/RocketLauncher.cs   | 25 ++++++++++++++++++-
 4 files changed, 60 insertions(+), 8 deletions(-)

diff --git a/Assets/_Game/Scripts/Core/PixelCameraRig.cs b/Assets/_Game/Scripts/Core/PixelCameraRig.cs
index 1b14812..a78e77f 100644
--- a/Assets/_Game/Scripts/Core/PixelCameraRig.cs
+++ b/Assets/_Game/Scripts/Core/PixelCameraRig.cs
@@ -156,16 +156,16 @@ public void SetTarget(Transform target, bool snap = true)
             }
         }
 
-        /// <summary>
-        /// Converts a screen position (pixels, bottom-left origin, e.g. Mouse.current.position) into a world
-        /// ray from the low-res game camera, accounting for letterbox, scale, border and sub-texel offset.
-        /// </summary>
         /// <summary>Adds camera trauma (0..1). Shake = trauma² so small hits stay subtle.</summary>
         public void AddTrauma(float amount)
         {
             _trauma = Mathf.Clamp01(_trauma + Mathf.Max(0f, amount));
         }
 
+        /// <summary>
+        /// Converts a screen position (pixels, bottom-left origin, e.g. Mouse.current.position) into a world
+        /// ray from the low-res game camera, accounting for letterbox, scale, border and sub-texel offset.
+        /// </summary>
         public Ray ScreenPointToWorldRay(Vector2 screenPos)
         {
             Vector2 viewport = ScreenToGameViewport(screenPos);
diff --git a/Assets/_Game/Scripts/Core/WaveDirector.cs b/Assets/_Game/Scripts/Core/WaveDirector.cs
index ba4d2d6..00663ed 100644
--- a/Assets/_Game/Scripts/Core/WaveDirector.cs
+++ b/Assets/_Game/Scripts/Core/WaveDirector.cs
@@ -1,6 +1,7 @@
 using System;
 using System.Collections.Generic;
 using UnityEngine;
+using UnityEngine.AI;
 
 namespace DanceWithTheDevil
 {
@@ -272,8 +273,19 @@ private void EnqueueWindow(in WaveWindow window)
                     if (shooters-- > 0) _pending.Add(new PendingSpawn { Type = EnemyType.Shooter, ReleaseTime = release });
                 }
             }
-            // Keep the queue ordered by release time (earlier windows' late spawns stay in front).
-            _pending.Sort((a, b) => a.ReleaseTime.CompareTo(b.ReleaseTime));
+            // Keep the queue ordered by release time (earlier windows' late spawns stay in front). Insertion sort:
+            // List.Sort is unstable above 16 items and would shuffle the interleaved types of a sub-group.
+            for (int i = 1; i < _pending.Count; i++)
+            {
+                PendingSpawn item = _pending[i];
+                int j = i - 1;
+                while (j >= 0 && _pending[j].ReleaseTime > item.ReleaseTime)
+                {
+                    _pending[j + 1] = _pending[j];
+                    j--;
+                }
+                _pending[j + 1] = item;
+            }
         }
 
         /// <summary>Group <paramref name="index"/>'s share of <paramref name="total"/>; the remainder goes to earlier groups.</summary>
@@ -429,6 +441,9 @@ private void SpawnAt(EnemyType type, int entrance)
             if (pool == null || point == null) return;
 
             Vector3 position = point.position + point.right * UnityEngine.Random.Range(-_spawnJitter, _spawnJitter);
+            // The jitter can push the point into a wall; an agent that cannot attach never moves but still counts
+            // toward the active cap for the rest of the run. Snap to the nearest NavMesh point when there is one.
+            if (NavMesh.SamplePosition(position, out NavMeshHit hit, 1.5f, NavMesh.AllAreas)) position = hit.position;
             Vector3 facing = _player != null ? _player.position - position : point.forward;
             facing.y = 0f;
             Quaternion rotation = facing.sqrMagnitude > 1e-6f ? Quaternion.LookRotation(facing, Vector3.up) : point.rotation;
diff --git a/Assets/_Game/Scripts/UI/DevilScreen.cs b/Assets/_Game/Scripts/UI/DevilScreen.cs
index c4b6552..38113f0 100644
--- a/Assets/_Game/Scripts/UI/DevilScreen.cs
+++ b/Assets/_Game/Scripts/UI/DevilScreen.cs
@@ -47,6 +47,11 @@ public sealed class DevilScreen : MonoBehaviour
         private enum Mode { Hidden, Entering, Line, Card }
