diff --git a/Assets/_Game/Scripts/Weapons/RocketLauncher.cs b/Assets/_Game/Scripts/Weapons/RocketLauncher.cs
index 4dfd3a0..29563a4 100644
--- a/Assets/_Game/Scripts/Weapons/RocketLauncher.cs
+++ b/Assets/_Game/Scripts/Weapons/RocketLauncher.cs
@@ -58,6 +58,7 @@ public sealed class RocketLauncher : MonoBehaviour
         [SerializeField, Range(0f, 1f)] private float _launchIntensity = 0.35f;
 
         private readonly Collider[] _overlaps = new Collider[MaxOverlaps];
+        private readonly RaycastHit[] _lineHits = new RaycastHit[16];
         private readonly HashSet<IDamageable> _damagedThisExplosion = new HashSet<IDamageable>();
         private ProjectileDetonateHandler _onDetonate;
         private Transform _ownerRoot;
@@ -208,7 +209,10 @@ private void Explode(Projectile projectile, Vector3 point, Vector3 normal)
                 if (_ownerRoot != null && collider.transform.IsChildOf(_ownerRoot)) continue; // never the player
 
                 IDamageable target = collider.GetComponentInParent<IDamageable>();
-                if (target == null || !_damagedThisExplosion.Add(target)) continue;
+                if (target == null || _damagedThisExplosion.Contains(target)) continue;
+                // Unbroken walls shield what is behind them (GDD §7 rule for module blasts, applied to rockets too).
+                if (IsShieldedByWall(point + normal * 0.05f, collider.bounds.center)) continue;
+                _damagedThisExplosion.Add(target);
 
                 var targetComponent = target as Component;
                 Vector3 targetPosition = targetComponent != null ? targetComponent.transform.position : collider.bounds.center;
@@ -237,5 +241,24 @@ private void Explode(Projectile projectile, Vector3 point, Vector3 normal)
             });
             Exploded?.Invoke(point);
         }
+
+        /// <summary>True if a non-damageable collider (not the owner) lies between the blast point and the target.</summary>
+        private bool IsShieldedByWall(Vector3 from, Vector3 to)
+        {
+            Vector3 delta = to - from;
+            float distance = delta.magnitude;
+            if (distance <= 1e-4f) return false;
+            int count = Physics.RaycastNonAlloc(from, delta / distance, _lineHits, distance, _explosionMask,
+                QueryTriggerInteraction.Ignore);
+            for (int i = 0; i < count; i++)
+            {
+                Collider collider = _lineHits[i].collider;
+                if (collider == null) continue;
+                if (_ownerRoot != null && collider.transform.IsChildOf(_ownerRoot)) continue;
+                if (collider.GetComponentInParent<IDamageable>() != null) continue;
+                return true;
+            }
+            return false;
+        }
     }
 }
